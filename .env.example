# Copy to .env and fill in. Only ORIGIN is strongly recommended; everything else is optional.

# The public address people use to reach Shiftnest. Used in email links and calendar feeds.
ORIGIN=http://localhost:3000

# Where the SQLite database lives. Back this file up!
DATABASE_PATH=./data/shiftnest.db

# Port and interface to listen on.
PORT=3000
# HOST=0.0.0.0

# --- Email (any SMTP provider: Postmark, Mailgun, SES, Brevo, Gmail, Fastmail…) ---
# Without these, emails are kept in Admin → Messages instead of being sent.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=secret
# SMTP_SECURE=false            # true for port 465
# Or a single URL instead of the variables above:
# SMTP_URL=smtps://user:pass@smtp.example.com:465
# MAIL_FROM="Riverside Food Bank <volunteer@example.org>"

# --- Text messages (optional, bring your own Twilio account) ---
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_FROM=+15551234567
# or: TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Behind a reverse proxy (Caddy, nginx, Traefik) ---
# ADDRESS_HEADER=x-forwarded-for   # real client IP for rate limiting
# XFF_DEPTH=1
# TRUST_PROXY=true                 # only needed if ORIGIN isn't set

# --- Try it out with sample data (never in production) ---
# SHIFTNEST_DEMO=true
# SHIFTNEST_DEMO_PASSWORD=shiftnest-demo
# SHIFTNEST_DEMO_TIMEZONE=America/New_York

# --- Advanced ---
# WORKER_INTERVAL_SECONDS=30       # how often reminders are checked
# SHIFTNEST_DISABLE_WORKERS=false  # turn off background sending
