{
	"name": "shiftnest",
	"version": "1.0.0",
	"description": "A clean, ad-free, self-hostable volunteer shift scheduler with free email reminders, shift swaps, hour logging and iCal feeds.",
	"license": "MIT",
	"author": "Joel Stain Lobo",
	"homepage": "https://github.com/lobojoel2003/Shiftnest#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/lobojoel2003/Shiftnest.git"
	},
	"bugs": {
		"url": "https://github.com/lobojoel2003/Shiftnest/issues"
	},
	"keywords": [
		"volunteer",
		"scheduling",
		"shifts",
		"sign-up",
		"nonprofit",
		"self-hosted",
		"sveltekit",
		"sqlite",
		"ical"
	],
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=22.17"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"start": "node server.js",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "vitest run",
		"test:unit": "vitest",
		"test:e2e": "playwright test",
		"screenshots": "node scripts/screenshots.js",
		"ci": "npm run lint && npm run check && npm test && npm run build"
	},
	"dependencies": {
		"better-sqlite3": "^13.0.3",
		"nodemailer": "^10.3.1"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.14.0",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.65.0",
		"@sveltejs/adapter-node": "^6.0.1",
		"@sveltejs/kit": "^3.1.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/better-sqlite3": "^9.6.0",
		"@types/mailparser": "^3.9.0",
		"@types/node": "^22.19.19",
		"@types/nodemailer": "^8.0.2",
		"@types/smtp-server": "^3.5.13",
		"eslint": "^10.14.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.0",
		"globals": "^17.6.0",
		"mailparser": "^3.14.2",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"smtp-server": "^3.21.3",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.1",
		"vite": "^8.3.6",
		"vitest": "^5.1.0"
	}
}
